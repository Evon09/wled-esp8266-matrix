+// appends one formatted line (prefixed with millis()) to the ring buffer, dropping the oldest lines when full
+static void gifLogf(const char *fmt_P, ...) {
+  char line[120];
+  int n = snprintf_P(line, sizeof(line), PSTR("%lu: "), (unsigned long)millis());
+  va_list ap;
+  va_start(ap, fmt_P);
+  n += vsnprintf_P(line + n, sizeof(line) - n, fmt_P, ap);
+  va_end(ap);
+  if (n > (int)sizeof(line) - 2) n = sizeof(line) - 2;
+  line[n++] = '\n';
+  if (gifLogLen + n >= GIF_LOG_SIZE) {
+    uint16_t cut = GIF_LOG_SIZE / 2;
+    while (cut < gifLogLen && gifLogBuf[cut-1] != '\n') cut++; // cut at a line boundary
+    memmove(gifLogBuf, gifLogBuf + cut, gifLogLen - cut);
+    gifLogLen -= cut;
+  }
+  memcpy(gifLogBuf + gifLogLen, line, n);
+  gifLogLen += n;
+  gifLogBuf[gifLogLen] = '\0';
+}
